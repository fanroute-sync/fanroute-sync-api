DOMAIN=example.com

POSTGRES_DB=busan_trip
POSTGRES_USER=app
POSTGRES_PASSWORD=changeme

REDIS_PASSWORD=changeme

JWT_SECRET=changeme

# 콤마로 구분된 허용 origin 목록. 예: https://troadie.vercel.app,https://sparkling-alfajores-f44fd5.netlify.app
# Task 8에서 실제 프론트 URL이 확정되면 갱신 필요.
CORS_ALLOWED_ORIGINS=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GEMINI_API_KEY=
KOPIS_SERVICE_KEY=
TOUR_API_KEY=

# Firebase 서비스 계정 JSON은 SSM SecureString(/troadie/firebase-service-account)에서
# EC2 /opt/troadie/secrets/로만 내려받습니다. 이 파일에는 절대 넣지 않습니다.
FIREBASE_ENABLED=false
